def eval_actor(actor_crit, env):
    
    with torch.no_grad():
        rewards_acc = 0 
        obs, info = env.reset() 
        while True: 
            state = obs
            action = actor_crit.pi_d(state)
            obs, reward, terminated, truncated, info = env.step(action)
            rewards_acc += reward 
            if terminated or truncated: 
                return rewards_acc 

